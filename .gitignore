__pycache__/
*.pyc
*.pyo
.DS_Store
quorum-review-workspace/
bash-macos-workspace/
swiftui-native-ux-workspace/
musickit-diagnostics-workspace/
temp/
refs/

# contest-refactor working artifacts — created when dogfooding /contest-refactor on a
# skill dir; never commit them into the skill under review. contest-refactor's own
# evals/ fixtures legitimately track these names, so re-include that subtree.
CURRENT_REVIEW.json
CURRENT_REVIEW.md
REVIEW_HISTORY.json
REVIEW_HISTORY.md
findings_registry.json
!contest-refactor/evals/**

# ...but that negation is broad enough to re-include Python build artifacts, and the
# gold-corpus packs ship runnable code whose oracles are executed in place. Without these
# two lines every oracle run leaves committable __pycache__ behind. Later rules win, so
# these must stay after the negation above.
contest-refactor/evals/**/__pycache__/
contest-refactor/evals/**/*.pyc

# Per-agent skill install dirs (local symlinks / npx-skills artifacts, not repo content).
# Keep skill-evaluator-1.0.0 — it is tracked and referenced by CLAUDE.md.
.agents/
.claude/skills/*
!.claude/skills/skill-evaluator-1.0.0/
skills-lock.json
