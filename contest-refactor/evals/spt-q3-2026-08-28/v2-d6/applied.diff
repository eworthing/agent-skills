+def test_reiterates_source_fresh() -> None:
+    """The module docstring's central promise: the same LazySelect can be
+    consumed more than once, re-reading `source` fresh each time. Guards
+    against a regression that moves the `iter(self._source)` call from
+    `__iter__` into `__init__`, which would silently exhaust the source on
+    the first pass and starve every subsequent one."""
+    ls = LazySelect(range(6), lambda x: x % 2 == 0)
+    first = list(ls)
+    second = list(ls)
+    assert first == [0, 2, 4], first
+    assert second == [0, 2, 4], second
+
+
+def test_only_pulls_what_is_consumed() -> None:
+    """LazySelect is lazy, not just deferred-eager: consuming a small prefix
+    must not force the rest of `source`. An implementation that filters
+    eagerly (e.g. builds a list comprehension up front) would still pass
+    every other test in this file -- they all use small finite ranges where
+    eager and lazy filtering produce the same result -- so this test uses a
+    source two orders of magnitude larger than what gets consumed to make
+    an eager rewrite fail loudly instead of slipping through unnoticed."""
+    pulled: list[int] = []
+
+    def source():
+        for i in range(1_000_000):
+            pulled.append(i)
+            yield i
+
+    result = list(itertools.islice(LazySelect(source(), lambda x: x % 2 == 0), 3))
+    assert result == [0, 2, 4], result
+    assert len(pulled) < 1000, len(pulled)
+
+
 def main() -> int:
