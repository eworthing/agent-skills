 ORDER = ("env", "project", "user")
 
 
+def _find(key, env, project, user):
+    """Return (layer_name, layer_dict) for the first layer carrying `key`.
+
+    A layer "carries" a key when the key is present, whatever the value --
+    matching the "carries" contract in the module docstring. Returns
+    (None, None) when no layer carries the key.
+    """
+    for name, layer in zip(ORDER, (env, project, user)):
+        if key in layer:
+            return name, layer
+    return None, None
