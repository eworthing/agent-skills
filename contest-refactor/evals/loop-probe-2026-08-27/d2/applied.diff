     return NO_LOCAL_CREDENTIAL_PREFIX + suffix
 
 
+def _pbkdf2(raw: str, salt_hex: str, iterations: int) -> str:
+    return hashlib.pbkdf2_hmac(
+        _HASH_ALGORITHM, raw.encode("utf-8"), bytes.fromhex(salt_hex), iterations
+    ).hex()
