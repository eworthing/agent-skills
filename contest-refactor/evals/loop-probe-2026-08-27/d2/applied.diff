 def set_credential(raw: str) -> str:
     """Encode `raw` into a storable credential value.
 
-    Never starts with NO_LOCAL_CREDENTIAL_PREFIX, so an encoded credential
-    and a no-local-credential marker can never be mistaken for each
-    other.
+    A salted PBKDF2-HMAC-SHA256 hash, not a reversible transform: nothing
+    short of brute force recovers `raw` from the stored value. Never
+    starts with NO_LOCAL_CREDENTIAL_PREFIX, so an encoded credential and a
+    no-local-credential marker can never be mistaken for each other.
     """
-    return "$enc$" + raw[::-1]
+    salt = secrets.token_hex(_SALT_BYTES)
+    digest = _pbkdf2(raw, salt, _ITERATIONS)
+    return f"{_ENCODED_PREFIX}{_ITERATIONS}${salt}${digest}"
 
 
