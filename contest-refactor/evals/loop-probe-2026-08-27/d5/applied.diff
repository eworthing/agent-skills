+def test_plot_legend_labels_for_panels() -> None:
+    """Panels must get real legend labels the same way Lanes do -- before
+    the apply_plot fix this returned [None, None] because only Lane got
+    its key forwarded."""
+    panels = Clustered(RECORDS, key=lambda r: r["team"]).panels(["x"])
+    labels = plot_legend_labels(panels)
+    assert labels == ["north", "south"], labels
+
+
+def test_apply_general_pins_label_and_calls_fn() -> None:
+    """apply_general's whole contract: pin `.label` from `.key`, then call
+    fn on each group. Previously untested -- this is the only current
+    caller-side proof its mutation still does what its docstring claims."""
+    lanes = Clustered(RECORDS, key=lambda r: r["team"]).lanes("x")
+    seen = apply_general(lanes, lambda g: g.label)
+    assert seen == ["north", "south"], seen
+    assert [lane.label for lane in lanes] == ["north", "south"]
+
+
 def main() -> int:
