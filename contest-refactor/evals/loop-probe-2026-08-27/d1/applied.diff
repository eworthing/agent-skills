+def test_empty_string_is_a_carried_override_not_an_absence():
+    # An explicitly empty value in a higher layer still wins -- and
+    # describe_source must agree with effective_value about *which*
+    # layer won, per the module's documented "carries" contract.
+    env = {"retries": ""}
+    project = {"retries": "5"}
+    assert _call(settings.effective_value, "retries", env=env, project=project) == ""
+    assert _call(settings.describe_source, "retries", env=env, project=project) == "env"
