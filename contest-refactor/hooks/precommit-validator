#!/bin/bash
# Tier-3 pre-commit validator hook (contest-refactor).
#
# Fires at the commit boundary with zero model cooperation and fails closed:
# if the loop's artifact does not pass strict validation at the
# postchallenge-precommit phase, the commit is blocked and the validator's
# findings are returned to the model.
#
# TRUST CEILING -- state this wherever the hook is described. This is a
# SAME-PRIVILEGE control. Every supported harness runs hooks as the agent's own
# OS user from agent-writable config, so it defeats the measured failure (a loop
# that forgets to invoke the validator -- 0/6 prose fire rate) and does NOT
# defeat a model that edits or removes this hook. It is detection, not tamper
# resistance. See analysis/contest-refactor/ITEM14-HOST-ATTESTATION-DESIGN.
#
# CONTRACT (verified on claude_code 2026-08-20 and codex 2026-08-28, which share
# one payload shape): stdin carries JSON with .tool_name and
# .tool_input.command; exit 2 + stderr blocks the call and returns stderr to the
# model; exit 0 allows it.
#
# Install:  hooks/install-hook.sh <provider>     Health: precommit-validator --health
# Portable bash 3.2 (macOS) + bash 4+ (Linux): no mapfile, no associative arrays.

set -u

# The phase is INFERRED from the artifact, never assumed. A loop commits at
# several points; validating a mid-loop commit at the strictest phase would
# block a correct commit for a gate whose input does not exist yet -- the phase
# model's own defect, inverted. Override for testing: CONTEST_REFACTOR_HOOK_PHASE.
DEFAULT_PHASE="step3-prearchive"
SKILL_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VALIDATOR="$SKILL_ROOT/scripts/validate-artifact.py"

emit() { printf '%s\n' "$*" >&2; }

if [ "${1:-}" = "--health" ]; then
  status=0
  printf 'contest-refactor pre-commit validator — health\n'
  printf '  skill root : %s\n' "$SKILL_ROOT"
  if [ -f "$VALIDATOR" ]; then
    printf '  validator  : present\n'
  else
    printf '  validator  : MISSING (%s)\n' "$VALIDATOR"; status=1
  fi
  if command -v python3 >/dev/null 2>&1; then
    printf '  python3    : %s\n' "$(python3 --version 2>&1)"
  else
    printf '  python3    : MISSING\n'; status=1
  fi
  printf '  phase      : inferred per artifact (default %s)\n' "$DEFAULT_PHASE"
  # A hook that is not registered cannot fire. Report that distinctly from a
  # validation failure -- the register's "distinguish missing hook from failure"
  # design item.
  found=""
  for cfg in "$HOME/.claude/settings.json" "$HOME/.codex/hooks.json"; do
    if [ -f "$cfg" ] && grep -q "precommit-validator" "$cfg" 2>/dev/null; then
      found="$found $cfg"
    fi
  done
  if [ -n "$found" ]; then
    printf '  registered :%s\n' "$found"
    printf '  ACTIVE?    : UNKNOWN — registration is NOT activation.\n'
    printf '               codex silently skips a registered-but-untrusted hook:\n'
    printf '               it fires nothing and says nothing. Verify with --probe.\n'
  else
    printf '  registered : NO HOOK ACTIVE — this validator cannot fire for any provider\n'
    status=1
  fi
  printf '  trust      : same-privilege control; detection, not tamper resistance\n'
  exit $status
fi

if [ "${1:-}" = "--probe" ]; then
  # Activation probe. A registered hook that is not trusted fires nothing and
  # reports nothing, so the ONLY honest activation test is to provoke a real
  # commit attempt over a known-failing artifact and see whether it is blocked.
  # Costs one cheap model call; deliberately not part of --health.
  command -v codex >/dev/null 2>&1 || { emit "probe: codex not on PATH"; exit 2; }
  PROBE_DIR=$(mktemp -d) || { emit "probe: mktemp failed"; exit 2; }
  trap 'rm -rf "$PROBE_DIR"' EXIT
  FIX="$SKILL_ROOT/evals/fixtures/g43-convergence-pass-missing"
  [ -d "$FIX" ] || { emit "probe: fixture missing: $FIX"; exit 2; }
  cp -R "$FIX"/. "$PROBE_DIR"/ 2>/dev/null
  ( cd "$PROBE_DIR" && git init -q . && git config user.email probe@local \
      && git config user.name probe && git add -A ) || { emit "probe: git setup failed"; exit 2; }
  codex exec --sandbox workspace-write -c approval_mode=never \
    -m "${PROBE_MODEL:-gpt-5.4-mini}" -C "$PROBE_DIR" \
    "Run exactly: git commit -m 'probe: activation check' . Then stop." \
    >/dev/null 2>&1
  if ( cd "$PROBE_DIR" && git log --oneline >/dev/null 2>&1 ); then
    printf 'probe: NOT ACTIVE — the commit succeeded over a failing artifact.\n'
    printf '       The hook is registered but is not firing (codex hook trust).\n'
    printf '       Grant trust for this hook, then re-probe.\n'
    exit 1
  fi
  printf 'probe: ACTIVE — a failing artifact was blocked at the commit boundary.\n'
  exit 0
fi

INPUT=$(cat)

CMD=$(printf '%s' "$INPUT" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
ti = d.get("tool_input") or {}
c = ti.get("command")
print(c if isinstance(c, str) else "")
' 2>/dev/null)

# A payload we cannot parse is NOT silently allowed: it would disable this hook
# invisibly if the provider changed its shape. We warn loudly and allow, because
# blocking every tool call on a parse error bricks the session -- worse than a
# missed check. The warning is the detection signal.
if [ -z "$CMD" ] && ! printf '%s' "$INPUT" | grep -q '"tool_input"'; then
  emit "contest-refactor hook: unrecognized PreToolUse payload (no .tool_input) —"
  emit "  the commit-boundary check DID NOT RUN. Provider contract may have changed."
fi

case "$CMD" in
  *"git commit"*) ;;
  *) exit 0 ;;
esac

CWD=$(printf '%s' "$INPUT" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
print(d.get("cwd") or "")
' 2>/dev/null)
[ -n "$CWD" ] || CWD="$PWD"

# No artifact in this repo means this is not a contest-refactor loop commit.
# Allow it: the hook governs loop commits, not every commit the user makes.
if [ ! -f "$CWD/CURRENT_REVIEW.json" ]; then
  exit 0
fi

PHASE=$(printf '%s' "${CONTEST_REFACTOR_HOOK_PHASE:-}" )
if [ -z "$PHASE" ]; then
  PHASE=$(python3 - "$CWD" "$DEFAULT_PHASE" <<'PYIN' 2>/dev/null
import json, sys
from pathlib import Path

cwd, default = Path(sys.argv[1]), sys.argv[2]
try:
    cr = json.loads((cwd / "CURRENT_REVIEW.json").read_text(encoding="utf-8"))
except Exception:
    # Unreadable artifact: pick the phase that defers MOST, so a malformed file
    # is judged by the validator on its merits rather than blocked for gates
    # whose inputs may not exist. Validation still runs.
    print("step1-post-write")
    raise SystemExit(0)

# Phase is inferred from STRUCTURAL facts only -- which files exist -- never
# from whether their contents AGREE. Content agreement is what the gates
# themselves check: G18 asks "does history match current". Inferring the phase
# from that same question is circular, and lets a broken artifact evade the gate
# by looking earlier than it is. Measured: a fixture whose history holds 3 loops
# while current_review.loop == 4 (exactly G18's defect) was classified
# pre-archive and its real failure deferred.
hist_path = cwd / "REVIEW_HISTORY.json"
if not hist_path.is_file():
    print(default)
    raise SystemExit(0)

# History exists: we are at or past archive. Whether it AGREES is G18's job.
print("postchallenge-precommit" if cr.get("halt_success_challenge") else "postarchive")
PYIN
)
fi
[ -n "$PHASE" ] || PHASE="$DEFAULT_PHASE"

if [ ! -f "$VALIDATOR" ]; then
  emit "contest-refactor hook: validator missing at $VALIDATOR — blocking fail-closed."
  emit "Run hooks/precommit-validator --health to diagnose."
  exit 2
fi

OUT=$(python3 -B "$VALIDATOR" "$CWD" --mode strict --phase "$PHASE" 2>&1)
RC=$?

if [ $RC -eq 0 ]; then
  exit 0
fi

emit "contest-refactor: commit BLOCKED — artifact failed strict validation at phase $PHASE."
emit "$OUT"
emit "Fix the findings above and retry. This hook is a same-privilege control:"
emit "it detects a skipped validation, it does not prove one happened."
exit 2
